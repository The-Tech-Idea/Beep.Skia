<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFrameworks Condition="'$(BeepSkiaPortableTargetFramework)' != 'net10.0'">net8.0;net10.0</TargetFrameworks>
		<TargetFrameworks Condition="'$(BeepSkiaPortableTargetFramework)' == 'net10.0'">net10.0</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<NoWarn>$(NoWarn);NU1701</NoWarn>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Authors>The Tech Idea</Authors>
		<Company>The Tech Idea</Company>
		<Copyright>2025</Copyright>
		<PackageProjectUrl>https://github.com/The-Tech-Idea/Beep.Skia</PackageProjectUrl>
		<RepositoryUrl>https://github.com/The-Tech-Idea/Beep.Skia</RepositoryUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Description>Blazor WebAssembly host controls for Beep.Skia components</Description>
		<PackageTags>skia, blazor, wasm, controls, diagramming, web</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="SkiaSharp" Version="4.150.1" />
		<PackageReference Include="SkiaSharp.Views.Blazor" Version="4.150.1" />
		<!-- HarfBuzzSharp lists no WebAssembly native asset; WASM hosts link it explicitly, like SkiaSharp.Views.Blazor does for Skia. -->
		<PackageReference Include="HarfBuzzSharp.NativeAssets.WebAssembly" Version="14.2.1.1" />
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.0" Condition="'$(TargetFramework)' == 'net8.0'" />
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.12" Condition="'$(TargetFramework)' == 'net10.0'" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Beep.Skia\Beep.Skia.csproj" />
		<ProjectReference Include="..\Beep.Skia.Model\Beep.Skia.Model.csproj" />
	</ItemGroup>
  <!-- Named per-framework restore metadata is a build input, never a static/runtime asset. -->
  <ItemGroup>
    <Content Remove="packages.net10.lock.json" />
  </ItemGroup>
</Project>
